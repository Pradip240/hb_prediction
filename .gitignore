# ======================================================================
# rPPG pipeline
# ======================================================================

# --- Generated pipeline outputs (all stages write here) ---
output/
!output/.gitkeep
!output/*/.gitkeep

# --- Data inputs (large / private) ---
data/
!data/videos/.gitkeep
data/ground_truth.csv

# --- Downloaded model weights (fetched at runtime, not source) ---
face_landmarker.task
*.task

# --- Stray intermediate arrays / media if produced outside output/ ---
*.npz
*.npy
*.mp4
*.avi
*.mov
*.mkv
*.png
*.jpg
*.jpeg
*.csv

# ======================================================================
# Python
# ======================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# Virtual environments
.env
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

